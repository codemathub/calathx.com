# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/calathx
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string

# Backblaze B2 (S3-Compatible Object Storage)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=your_b2_key_id
B2_KEY_NAME=calthx-app-key
B2_APP_KEY=your_b2_application_key
B2_BUCKET_NAME=calathx-media

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=CalathX <noreply@calathx.com>
CONTACT_EMAIL=info@calathx.com

