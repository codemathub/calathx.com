# Server Configuration
NODE_ENV=production
# Choose any free port on your VPS (e.g. 5000, 5001, 5002, 5050)
PORT=5000
CLIENT_URL=https://calathx.com,https://www.calathx.com
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/calatx?retryWrites=true&w=majority

# Security (Generate random 64-character strings: openssl rand -base64 48)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here

# Backblaze B2 (S3-Compatible Object Storage for Uploads)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=your_b2_key_id
B2_KEY_NAME=your_b2_key_name
B2_APP_KEY=your_b2_application_key
B2_BUCKET_NAME=your_b2_bucket_name

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=CalathX <noreply@calathx.com>
CONTACT_EMAIL=info@calathx.com

